{
  "name": "holdem-learning-table",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx server.ts --dev",
    "build": "next build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "backup": "node scripts/backup-db.mjs",
    "close-expired-rooms": "node --import tsx scripts/close-expired-rooms.ts",
    "test:realtime": "node --import tsx --test tests/realtime.test.ts",
    "format": "prettier --write app lib scripts deploy server.ts next.config.ts package.json tsconfig.json tailwind.config.ts postcss.config.mjs README.md",
    "format:check": "prettier --check app lib scripts deploy server.ts next.config.ts package.json tsconfig.json tailwind.config.ts postcss.config.mjs README.md"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.23",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
